# The environment the service reads, for running it locally.
#
# Copy this file to .env, which git ignores, and fill in the values. Read
# docs/1-running.md first: with real AWS keys the service changes the
# account they belong to.
#
# Write each value without quotes and without a trailing comment, so the
# same file works for the shell and for docker run --env-file, which takes
# every value literally.

# Required. The service stops at start if any of these is unset or empty.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SERVER_CLIENT_ID=
SERVER_SECRET=
AWS_ACCOUNT_ID=
AWS_ACCOUNT_REGION=
MSK_CLUSTER_NAME=

# The DynamoDB tables. Without these lines the service uses the production
# tables (diaspora-keys-table, diaspora-users-table and
# diaspora-namespace-table). These are the tables the live tests use
# (docs/2-testing.md).
KEYS_TABLE_NAME=test-diaspora-keys-table
USERS_TABLE_NAME=test-diaspora-users-table
NAMESPACE_TABLE_NAME=test-diaspora-namespace-table

# Optional. Remove the leading # to set one. To leave a variable unset,
# keep its line commented out: an empty value is not the same as unset,
# and an empty CONSUMER_INSTANCE_TIMEOUT_MS stops the service at start.
#
# The MSK bootstrap brokers for IAM authentication, as comma-separated
# host:port pairs. Unset, the service makes no Kafka calls.
#DEFAULT_SERVERS=
# The most topics a namespace may hold.
#MAX_TOPICS_PER_NAMESPACE=50
# How long, in milliseconds, a consumer instance may sit idle before the
# service closes it.
#CONSUMER_INSTANCE_TIMEOUT_MS=300000
# The ARN of a managed policy to set as the permissions boundary of every
# IAM user the service creates.
#IAM_USER_PERMISSIONS_BOUNDARY_ARN=
