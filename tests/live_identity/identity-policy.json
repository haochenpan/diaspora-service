{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SweepListsUsersAndPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:ListUsers",
        "iam:ListPolicies"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadTestUsers",
      "Effect": "Allow",
      "Action": [
        "iam:GetUser",
        "iam:ListAccessKeys",
        "iam:ListAttachedUserPolicies",
        "iam:ListUserPolicies"
      ],
      "Resource": [
        "arn:aws:iam::<account-id>:user/msk-users/test-subject-*",
        "arn:aws:iam::<account-id>:user/test-subject-*"
      ]
    },
    {
      "Sid": "CreateTestUsersOnlyWithTheBoundary",
      "Effect": "Allow",
      "Action": "iam:CreateUser",
      "Resource": "arn:aws:iam::<account-id>:user/msk-users/test-subject-*",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::<account-id>:policy/diaspora-test/test-user-boundary"
        }
      }
    },
    {
      "Sid": "AttachTestPoliciesOnlyToBoundedTestUsers",
      "Effect": "Allow",
      "Action": "iam:AttachUserPolicy",
      "Resource": "arn:aws:iam::<account-id>:user/msk-users/test-subject-*",
      "Condition": {
        "ArnLike": {
          "iam:PolicyARN": "arn:aws:iam::<account-id>:policy/msk-policy/test-subject-*"
        },
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::<account-id>:policy/diaspora-test/test-user-boundary"
        }
      }
    },
    {
      "Sid": "DetachTestPoliciesFromTestUsers",
      "Effect": "Allow",
      "Action": "iam:DetachUserPolicy",
      "Resource": [
        "arn:aws:iam::<account-id>:user/msk-users/test-subject-*",
        "arn:aws:iam::<account-id>:user/test-subject-*"
      ],
      "Condition": {
        "ArnLike": {
          "iam:PolicyARN": "arn:aws:iam::<account-id>:policy/msk-policy/test-subject-*"
        }
      }
    },
    {
      "Sid": "ManageTestUserKeysAndDeleteTestUsers",
      "Effect": "Allow",
      "Action": [
        "iam:CreateAccessKey",
        "iam:DeleteAccessKey",
        "iam:DeleteUser"
      ],
      "Resource": [
        "arn:aws:iam::<account-id>:user/msk-users/test-subject-*",
        "arn:aws:iam::<account-id>:user/test-subject-*"
      ]
    },
    {
      "Sid": "ManageTestPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:ListPolicyVersions",
        "iam:DeletePolicyVersion"
      ],
      "Resource": "arn:aws:iam::<account-id>:policy/msk-policy/test-subject-*"
    },
    {
      "Sid": "ReadAndWriteTheTestTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:<region>:<account-id>:table/test-diaspora-keys-table",
        "arn:aws:dynamodb:<region>:<account-id>:table/test-diaspora-users-table",
        "arn:aws:dynamodb:<region>:<account-id>:table/test-diaspora-namespace-table"
      ]
    },
    {
      "Sid": "SweepReadsTheServiceNamespaceList",
      "Effect": "Allow",
      "Action": "dynamodb:GetItem",
      "Resource": "arn:aws:dynamodb:<region>:<account-id>:table/diaspora-users-table",
      "Condition": {
        "ForAllValues:StringEquals": {
          "dynamodb:LeadingKeys": [
            "__global_namespaces__"
          ]
        }
      }
    },
    {
      "Sid": "SweepReadsTestNamespaceRecords",
      "Effect": "Allow",
      "Action": "dynamodb:GetItem",
      "Resource": "arn:aws:dynamodb:<region>:<account-id>:table/diaspora-namespace-table",
      "Condition": {
        "ForAllValues:StringLike": {
          "dynamodb:LeadingKeys": [
            "test-namespace-*",
            "ns-test*"
          ]
        }
      }
    },
    {
      "Sid": "ConnectToTheCluster",
      "Effect": "Allow",
      "Action": "kafka-cluster:Connect",
      "Resource": "arn:aws:kafka:<region>:<account-id>:cluster/<cluster-name>/<cluster-uuid>"
    },
    {
      "Sid": "UseTestTopics",
      "Effect": "Allow",
      "Action": [
        "kafka-cluster:CreateTopic",
        "kafka-cluster:DescribeTopic",
        "kafka-cluster:DeleteTopic",
        "kafka-cluster:ReadData",
        "kafka-cluster:WriteData"
      ],
      "Resource": [
        "arn:aws:kafka:<region>:<account-id>:topic/<cluster-name>/<cluster-uuid>/test-namespace-*",
        "arn:aws:kafka:<region>:<account-id>:topic/<cluster-name>/<cluster-uuid>/ns-test*"
      ]
    },
    {
      "Sid": "UseTestConsumerGroups",
      "Effect": "Allow",
      "Action": [
        "kafka-cluster:DescribeGroup",
        "kafka-cluster:AlterGroup"
      ],
      "Resource": "arn:aws:kafka:<region>:<account-id>:group/<cluster-name>/<cluster-uuid>/ns-test*"
    }
  ]
}
