{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TestUsersUseOnlyTestTopicsAndGroups",
      "Effect": "Allow",
      "Action": [
        "kafka-cluster:Connect",
        "kafka-cluster:DescribeTopic",
        "kafka-cluster:ReadData",
        "kafka-cluster:WriteData",
        "kafka-cluster:DescribeGroup",
        "kafka-cluster:AlterGroup"
      ],
      "Resource": [
        "arn:aws:kafka:<region>:<account-id>:cluster/<cluster-name>/<cluster-uuid>",
        "arn:aws:kafka:<region>:<account-id>:topic/<cluster-name>/<cluster-uuid>/ns-test*",
        "arn:aws:kafka:<region>:<account-id>:group/<cluster-name>/<cluster-uuid>/ns-test*"
      ]
    }
  ]
}
